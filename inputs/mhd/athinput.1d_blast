<comment>
problem   = 1D Blast Wave in Polytropic Stellar Profile
configure = --prob=1d_blast --coord=cartesian --eos=adiabatic --flux=hlle -s --mpi --hdf5

<job>
problem_id = 1d_blast    # problem ID: basename of output filenames

<output1>
file_type   = hdf5
data_format = double
variable    = prim,cons
dt          = 0.01       # time increment between outputs

<output2>
file_type   = hst
dt          = 0.001

<time>
cfl_number  = 0.25       # CFL number
nlim        = -1         # cycle limit (-1 = unlimited)
tlim        = 10.0        # time limit
integrator  = vl2
xorder      = 2
ncycle_out  = 100

<mesh>
nx1         = 2048       # zones along x (the propagation direction)
x1min       = 0.0
x1max       = 2.0
ix1_bc      = reflecting  # reflecting at x=0 (star center symmetry)
ox1_bc      = outflow

nx2         = 1          # collapsed y-direction
x2min       = -0.5
x2max       = 0.5
ix2_bc      = periodic
ox2_bc      = periodic

nx3         = 1          # collapsed z-direction
x3min       = -0.5
x3max       = 0.5
ix3_bc      = periodic
ox3_bc      = periodic

#refinement    = adaptive
#numlevel      = 3
#derefine_count = 5
#adapt_interval = 10

<meshblock>
nx1 = 8
nx2 = 1
nx3 = 1

<hydro>
gamma   = 1.3333333333333333   # 4/3 (ultra-relativistic)
dfloor  = 1e-28
pfloor  = 1e-34

<problem>
# Stellar structure (polytrope)
star_radius   = 1.0
poly_index    = 3.0
poly_csv_path = /scratch/aripoll/athena/polytrope_n3.00.csv
cs_factor     = 1e-6            # scale initial pressure (lower = cooler star)

# Pressure bomb: over-pressurize the innermost region to seed the blast
bomb_radius   = 0.2            # cells with x < bomb_radius get the overpressure
bomb_p_ratio  = 1.0e4           # factor by which pressure is boosted

# Ambient medium beyond the star
ambient_rho   = 1.0e-25
ambient_p     = 1.0e-25

# Transverse velocity (collapsed y-direction, still contributes to Lorentz factor).
# Specify either vy_bulk directly (beta_y) or Gam_bulk (Lorentz factor of transverse boost).
# If both are given, vy_bulk takes priority.
vy_bulk       = 0              # transverse beta_y  (0 = no transverse boost)
Gam_bulk      = 1              # Lorentz factor alternative; ignored if vy_bulk != 0

# AMR parameters (only active when refinement = adaptive)
thr           = 0.5             # refine when dimensionless log-gradient > thr
